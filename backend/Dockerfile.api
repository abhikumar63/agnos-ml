# Stage 1: Build the Go binary
FROM golang:1.26.4-alpine AS builder

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code and build
COPY . .
# Build the binary specifically from the cmd/api path
RUN go build -o agnos_api cmd/api/main.go

# Stage 2: Create the lightweight runtime container
FROM alpine:latest

WORKDIR /app
COPY --from=builder /app/agnos_api .

# Expose the API port
EXPOSE 8080

CMD ["./agnos_api"]